# Copy to .env.local for local dev. In Vercel, set these in
# Project Settings -> Environment Variables instead of committing a real .env.

# From the Neon dashboard: Connection Details -> "Pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/budget?sslmode=require

# Shared secret your cron/sync route checks for, so random internet traffic
# can't trigger a bank sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# Filled in once you wire up Plaid (see README step 9).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Filled in once you wire up push alerts (see README step 10).
NTFY_TOPIC=

# Password-protects the dashboard. AUTH_SECRET signs the session cookie
# (generate with: openssl rand -hex 32); DASHBOARD_PASSWORD is what you type
# on the login page.
AUTH_SECRET=
DASHBOARD_PASSWORD=

# Optional. Lets uncategorized transactions fall back to an AI guess
# (cached as a new rule afterward, so each merchant only hits this once).
# Get one at console.anthropic.com. Categorization just leaves transactions
# as "uncategorized" if this is unset.
ANTHROPIC_API_KEY=
